burlap.algorithm=DeepQLearning
burlap.num_of_episodes=200

# --- DeepQLearning ---
burlap.qlearning.dqn_lr=0.001
burlap.qlearning.gamma=0.9
# epsilon goes from epsilonval down to epsilonmin, losing decayedepsilonstep per episode
burlap.qlearning.epsilonval=1.0
burlap.qlearning.epsilonmin=0.1
burlap.qlearning.decayedepsilonstep=0.006
# neurons of each of the two hidden layers: the big level has 204 inputs and 142 actions
burlap.network.hidden_size=128

burlap.network.replay_buffer_capacity=10000
burlap.network.batch_size=32
burlap.network.min_replay_size=64
burlap.network.target_update_frequency=100
