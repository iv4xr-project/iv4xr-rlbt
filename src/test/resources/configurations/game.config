game.mode=training
game.burlapConfig=src/test/resources/configurations/burlap_test.config
game.lrSingleAgent=true
game.lrSingleAgentSutConfig=src/test/resources/configurations/lrLevelSingleAgent.config
game.lrMultiAgentSutConfig=src/test/resources/configurations/lrLevelMultiAgent.config

game.mineAgentSutConfig=src/test/resources/configurations/mineAgent.config
game.mineAgentBurlapConfig=src/test/resources/configurations/burlap_minecraft.config
game.mineAgentUseBaseline=false
game.mineAgentSystem=combat
# combat = mob fight (APPROACH/ATTACK/RETREAT); exploration = coverage of the environment states
game.mineExplorationTestbenchConfig=src/test/resources/configurations/testbench_exploration.json
# testbench config used by exploration only: a /status scan wide enough to cover the whole level
game.mineExplorationSutConfig=src/test/resources/configurations/mineExplorer.config
# SUT config used by exploration only: its level, its budget of actions, the wait after an action
game.mineExplorationBurlapConfig=src/test/resources/configurations/burlap_minecraft_exploration.config
# BURLAP config used by exploration only: its network is far larger than the combat one